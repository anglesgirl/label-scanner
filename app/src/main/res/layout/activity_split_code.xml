<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF1F7"
    android:fillViewport="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="每箱一行：点「扫」扫入集成码，也可以直接粘贴；勾选要拆的箱，最后一起拆解"
                android:textColor="#5A6B8C"
                android:textSize="13sp" />

            <!-- 每箱一行：勾选 + 集成码输入框 + 扫 + 删（行由代码动态生成） -->
            <LinearLayout
                android:id="@+id/llBoxes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnAddBox"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:text="＋ 再加一箱"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 手动粘贴集成码 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="粘贴集成码（逗号分隔，如 SN1,SN2,SN3）"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#33405A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etManualCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="SN1,SN2,SN3"
                android:textSize="14sp"
                android:textColor="#14213D"
                android:textColorHint="#9AA7BD"
                android:inputType="text" />

            <Button
                android:id="@+id/btnSplit"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#E65100"
                android:text="🧩 拆解选中的"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:minWidth="72dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- 集成码原文 -->
        <TextView
            android:id="@+id/tvSourceCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="12sp"
            android:textColor="#5A6B85"
            android:visibility="gone" />

        <!-- 拆分结果列表：每个 SN 一行（二维码 + SN + 保存） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="拆分结果（每 SN 一个条码）"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#33405A" />

        <LinearLayout
            android:id="@+id/llSplitResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- 操作按钮 -->
        <Button
            android:id="@+id/btnSaveAll"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1B9E4B"
            android:text="💾 全部保存到相册"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResetSplit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#F2F4F8"
            android:text="🔄 清空重来"
            android:textColor="#33405A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSplitStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="#1B6EF3"
            android:minHeight="40dp" />

    </LinearLayout>
</ScrollView>
