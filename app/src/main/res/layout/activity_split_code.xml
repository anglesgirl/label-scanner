<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_bg"
    android:fillViewport="true">

    <!-- ScrollView 只允许一个直接子元素，所有内容都放在这个垂直容器里 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="每箱一行：点「扫」扫入集成码，也可以直接粘贴；勾选要拆的箱，最后一起拆解"
                android:textColor="@color/ls_text_dim"
                android:textSize="13sp" />

            <!-- 每箱一行：勾选 + 集成码输入框 + 扫 + 删（行由代码动态生成） -->
            <LinearLayout
                android:id="@+id/llBoxes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnAddBox"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:text="＋ 再加一箱" />

        <!-- 候选码区：本次扫到的码先全量收下，再由用户逐个决定填入哪一箱。
             采集层负责"不丢"，分配交给用户 —— 这是两种不同性质的判断。 -->
        <TextView
            android:id="@+id/tvCandTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📥 候选码（点「填入」指定归属）"
            android:textColor="@color/ls_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llScanCandidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone" />


        <!-- 手动粘贴集成码 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="粘贴集成码（逗号分隔，如 SN1,SN2,SN3）"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/ls_text_dim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etManualCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="SN1,SN2,SN3"
                android:textSize="14sp"
                android:textColor="@color/ls_text"
                android:textColorHint="@color/ls_hint"
                android:inputType="text" />

            <Button
                android:id="@+id/btnSplit"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/ls_warn"
                android:text="🧩 拆解选中的"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:minWidth="72dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- 集成码原文 -->
        <TextView
            android:id="@+id/tvSourceCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="12sp"
            android:textColor="@color/ls_text_dim"
            android:visibility="gone" />

        <!-- 拆分结果列表：每个 SN 一行（二维码 + SN + 保存） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="拆分结果（每 SN 一个条码）"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ls_text_dim" />

        <LinearLayout
            android:id="@+id/llSplitResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- 操作按钮 -->
        <Button
            android:id="@+id/btnSaveAll"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ls_ok"
            android:text="💾 全部保存到相册"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResetSplit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/ls_card"
            android:text="🔄 清空重来"
            android:textColor="@color/ls_text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSplitStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/ls_primary"
            android:minHeight="40dp" />

    </LinearLayout>
</ScrollView>
