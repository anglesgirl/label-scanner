<?xml version="1.0" encoding="utf-8"?>
<!--
  集成码拆解页

  设计原则（用户要求：简洁、好用、看得懂）：
  - **输入只有一个地方**：顶部并排两个按钮（扫一箱 / 粘贴一箱）。
    之前每行箱里还有「扫」、下面又有个独立粘贴框，同一件事三个入口，
    用户不知道该用哪个 —— 已统一。
  - **箱列表只管"待拆的箱"**：勾选 + 内容摘要 + 删除。
  - **主操作唯一**：拆解选中的。
  - **结果区独立在下方**，不与输入区混在一起。
  - 空的区块一律隐藏（标题也隐藏），避免一屏全是空占位。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧩 集成码拆解"
            android:textColor="@color/ls_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="扫或粘贴整箱集成码，勾选后一起拆成单个序列号"
            android:textColor="@color/ls_text_dim"
            android:textSize="13sp" />

        <!-- 唯一的输入入口：扫一箱 / 粘贴一箱 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScanBox"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="@color/ls_primary"
                android:text="📷 扫一箱"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnPasteBox"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/ls_btn_scan"
                android:text="📋 粘贴一箱"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- 待拆解的箱：有内容才显示 -->
        <TextView
            android:id="@+id/tvBoxTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="待拆解的箱"
            android:textColor="@color/ls_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llBoxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- 主操作：唯一 -->
        <Button
            android:id="@+id/btnSplit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ls_warn"
            android:text="🧩 拆解选中的"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <TextView
            android:id="@+id/tvSplitStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/ls_primary" />

        <!-- 结果区（拆完才出现，与输入区分离） -->
        <View
            android:id="@+id/dividerResult"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/ls_border"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSourceCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/ls_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llSplitResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnSaveAll"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ls_ok"
            android:text="💾 全部保存到相册"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnResetSplit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/ls_card"
            android:text="🔄 清空重来"
            android:textColor="@color/ls_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
