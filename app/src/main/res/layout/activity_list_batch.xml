<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ls_bg"
    android:paddingHorizontal="14dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="双页清单录入"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/ls_text" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="先识别物料/生产日期，再逐页拍摄并累计集成码；所有页完成后统一核对保存"
        android:textSize="12sp"
        android:textColor="@color/ls_text_dim" />
    <TextView
        android:id="@+id/tvBatchLastSaved"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="上次保存序列号：读取中…"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/ls_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="1. 托盘信息页：登记栈板条码（WMS 托盘码）"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ls_text" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnTrayPhoto"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/ls_ok"
            android:text="拍托盘页"
            android:textSize="11sp"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnTrayDoc"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:backgroundTint="@color/ls_accent"
            android:text="文档扫描"
            android:textSize="11sp"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnTrayGallery"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/ls_badge"
            android:text="相册导入"
            android:textSize="11sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvTrayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="尚未识别托盘信息页；也可用扫码枪直接填入"
        android:textSize="11sp"
        android:textColor="@color/ls_text_dim" />
    <EditText
        android:id="@+id/etBatchTrayCode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="托盘码 *（SSCC/栈板条码）"
        android:inputType="textNoSuggestions"
        android:singleLine="true"
        android:textColor="@color/ls_text"
        android:textColorHint="@color/ls_hint" />
    <TextView
        android:id="@+id/tvBatchTraySerialCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="当前托盘序列号：正在查询…"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/ls_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="2. 基础信息页：核对物料编码和生产日期"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ls_text" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnHeaderPhoto"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/ls_ok"
            android:text="拍照"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnHeaderDoc"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:backgroundTint="@color/ls_accent"
            android:text="文档扫描"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnHeaderGallery"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/ls_badge"
            android:text="相册"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvHeaderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="尚未识别基础页；也可直接手动填写下方字段"
        android:textSize="11sp"
        android:textColor="@color/ls_text_dim" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etBatchMaterial"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:hint="物料编码 *"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:singleLine="true"
            android:textColor="@color/ls_text"
            android:textColorHint="@color/ls_hint" />
        <EditText
            android:id="@+id/etBatchDate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:hint="生产日期 *"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/ls_text"
            android:textColorHint="@color/ls_hint" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="3. 集成码页：从上往下实时扫，一页完成后再扫下一页；查看集成码和拆分后的序列号数量（识别不到可拍照/扫码补录）"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ls_text" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnCodesPhoto"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/ls_ok"
            android:text="实时扫一页"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnCodesDoc"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:backgroundTint="@color/ls_accent"
            android:text="文档扫描"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnCodesGallery"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/ls_badge"
            android:text="相册追加"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBatchCodeCounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="已识别集成码 0 个 · 拆分后 0 个序列号\n已保存 0 个序列号 · 待保存 0 个"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/ls_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etManualCode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:hint="扫码枪扫描或手工输入一个集成码"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:singleLine="true"
            android:textColor="@color/ls_text"
            android:textColorHint="@color/ls_hint" />
        <Button
            android:id="@+id/btnAddManualCode"
            android:layout_width="92dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:backgroundTint="@color/ls_primary"
            android:text="加入清单"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBatchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="先扫描基础页并核对字段，再开始收集集成码"
        android:textSize="11sp"
        android:textColor="@color/ls_text_dim" />
    <TextView
        android:id="@+id/tvCodesStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="尚未识别集成码"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/ls_primary" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBatchCodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnBatchSelectAll"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:backgroundTint="@color/ls_neutral"
            android:text="全选"
            android:textSize="13sp"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnBatchSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.3"
            android:layout_marginStart="5dp"
            android:backgroundTint="@color/ls_ok"
            android:text="保存 0 条"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
