<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF1F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ 设置"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#14213D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="69 码反查数据库（Turso libsql，内部使用，参数手动填写）"
            android:textSize="12sp"
            android:textColor="#5A6B85" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="数据库连接地址"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#33405A" />

        <EditText
            android:id="@+id/etTursoUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如 https://xxx-org.aws-ap-northeast-1.turso.io"
            android:textSize="14sp"
            android:textColor="#14213D"
            android:textColorHint="#9AA7BD" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="访问 Token"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#33405A" />

        <EditText
            android:id="@+id/etTursoToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="eyJ...（Turso 控制台生成）"
            android:textSize="13sp"
            android:textColor="#14213D"
            android:textColorHint="#9AA7BD"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnSaveTurso"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#1B6EF3"
            android:text="💾 保存配置"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnTestTurso"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1B9E4B"
            android:text="🔌 测试连接"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnInsertSample"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#F2F4F8"
            android:text="🧪 写入示例数据（6936358033251）"
            android:textColor="#33405A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTursoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="#1B6EF3"
            android:minHeight="40dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="说明：识别到 69 码且本地表未命中时，自动用此配置查询数据库（查询结果会缓存到本地）。"
            android:textSize="12sp"
            android:textColor="#5A6B85" />

    </LinearLayout>
</ScrollView>