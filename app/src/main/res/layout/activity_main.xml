<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EDF1F7"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="🏭 标签扫码入库"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#14213D" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="识别标签 → 按托盘入库 → 导出 WMS 喂系统"
        android:textSize="13sp"
        android:textColor="#5A6B85" />

    <Button
        android:id="@+id/btnModeSingle"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#2E7D32"
        android:text="📋 单条入库\n一箱一码 / 单品标签 / 可多条序列号"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnModeBox"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#6A1B9A"
        android:text="📦 单箱入库\n一箱多 SN / 二维码集成 SN / 自动分箱号"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnGotoCenter"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#1565C0"
        android:text="🗂️ 托盘中心\n多选托盘 / 导出 WMS（一次喂多个托盘）"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4A5568"
        android:text="⚙️ 设置（69 码反查数据库 / 测试识别）"
        android:textSize="14sp"
        android:textColor="#FFFFFF" />

</LinearLayout>