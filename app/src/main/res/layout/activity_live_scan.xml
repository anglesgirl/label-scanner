<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/pvScan"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部提示条 -->
    <LinearLayout
        android:id="@+id/scanTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#99000000"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvScanHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="对准条码，自动识别"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCloseScan"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#E53935"
            android:text="✕ 关闭"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:minWidth="72dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- 扫描框指示 -->
    <View
        android:layout_width="260dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_scan_frame" />


    <!-- 冻结截图：识别到多个码时把这一帧定格显示，用户在这张静止画面上点选。
         之所以要定格，是因为实时预览中码在移动，手指点下去时码已经移开，必然点错。 -->
    <ImageView
        android:id="@+id/ivSnapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 预览上直接点选条码：识别到的码在画面上框出来，点哪个选哪个（微信扫码那种手感）。
         不用底部列表 —— 列表要求眼睛在预览与列表间来回找对应，码多时极易点错。 -->
    <com.anglesgirl.labelscanner.camera.BarcodePickOverlay
        android:id="@+id/pickOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 连续扫多箱：累积已选，最后一起拆 -->
    <LinearLayout
        android:id="@+id/llPickBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#DD000000"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPickInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickDone"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="#1B6EF3"
                android:text="✓ 一起拆"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPickClear"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#33405A"
                android:text="清空"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
