<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EDF1F7"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 69码映射管理"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#14213D" />

        <Button
            android:id="@+id/btnEan69Refresh"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="#33405A"
            android:text="🔄 刷新"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btnEan69Add"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1B9E4B"
            android:text="➕ 新增"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="69码 → 物料编码 反查映射（云端 Turso 库，手机识别时自动使用）"
        android:textSize="12sp"
        android:textColor="#5A6B85" />

    <TextView
        android:id="@+id/tvEan69Status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="13sp"
        android:textColor="#1B6EF3"
        android:minHeight="24dp" />

    <LinearLayout
        android:id="@+id/llEan69List"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="8dp" />

</LinearLayout>
