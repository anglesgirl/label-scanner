<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ls_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:text="🔍 内窥镜扫码（USB UVC）"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/ls_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="2dp"
        android:text="插入内窥镜 → 对准标签 → 点「识别画面」，识别结果可保存/复制"
        android:textSize="12sp"
        android:textColor="@color/ls_text_dim" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:background="#000000">

        <com.serenegiant.usb.widget.UVCCameraTextureView
            android:id="@+id/usbCameraView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvUsbStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#88000000"
            android:text="未连接"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>

    <Button
        android:id="@+id/btnUsbRecognize"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/ls_accent"
        android:text="📸 识别画面"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnUsbBack"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/ls_text_dim"
        android:text="返回"
        android:textSize="14sp"
        android:textColor="#FFFFFF" />

</LinearLayout>
