<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEan69Code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ls_text" />

        <TextView
            android:id="@+id/tvEan69Material"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/ls_text_dim" />
    </LinearLayout>

    <Button
        android:id="@+id/btnEan69Del"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:backgroundTint="@color/ls_err_bg"
        android:text="🗑"
        android:textColor="@color/ls_err"
        android:textSize="14sp"
        android:minWidth="56dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
