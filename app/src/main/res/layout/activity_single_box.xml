<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 单箱入库（一箱多 SN）"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="识别外箱标签 → 自动填物料/箱号/日期 + 全部序列号 → 保存（每 SN 一行）"
            android:textSize="12sp"
            android:textColor="#888888" />

        <!-- 识别来源：拍照 / 文档扫描 / 相册 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTakePhoto"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="📷 拍照"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnScanDoc"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="📄 文档扫描"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPickGallery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🖼️ 相册"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 共享字段（每项：外部标识 + 输入框） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="共享字段（自动识别，可修改）"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#555555" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="物料编码（SAP 号）"
            android:textSize="12sp"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/etMaterial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="识别不到请手动输入"
            android:inputType="text"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="箱号 / LPN"
            android:textSize="12sp"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/etBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="识别不到请手动输入"
            android:inputType="text"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="生产日期（yyyyMMdd）"
            android:textSize="12sp"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="识别不到请手动输入"
            android:inputType="date"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="型号"
            android:textSize="12sp"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="参考信息，可不填"
            android:inputType="text"
            android:background="@android:drawable/editbox_background" />

        <!-- 序列号列表 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="序列号列表（一箱多个）"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#555555" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etManualSn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="手动输入序列号"
                android:inputType="text"
                android:background="@android:drawable/editbox_background" />

            <Button
                android:id="@+id/btnAddSn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="＋添加" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llSnList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <!-- 操作按钮 -->
        <Button
            android:id="@+id/btnSaveBox"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="✅ 保存入库（每 SN 一行）"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResetBox"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="🔄 清空，下一箱"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvBoxStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="#1A6B3C"
            android:minHeight="40dp" />

    </LinearLayout>
</ScrollView>